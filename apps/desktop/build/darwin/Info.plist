<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleName</key>
	<string>SendBeam</string>
	<key>CFBundleDisplayName</key>
	<string>SendBeam</string>
	<key>CFBundleExecutable</key>
	<string>sendbeam-desktop</string>
	<key>CFBundleIdentifier</key>
	<string>com.sendbeam.desktop</string>
	<key>CFBundleVersion</key>
	<string>0.0.0</string>
	<key>CFBundleShortVersionString</key>
	<string>0.0.0</string>
	<key>CFBundleIconFile</key>
	<string>icons.icns</string>
	<key>LSMinimumSystemVersion</key>
	<string>11.0</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright (c) 2026 Akshay7273</string>
	<key>NSSupportsAutomaticGraphicsSwitching</key>
	<true/>
	<!-- V20-PR07: "Open With" entry point. Finder can hand files and folders
	     to SendBeam; the app stages them into the send composer. Viewer role
	     + Alternate rank: never becomes the default opener. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>All files and folders</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.data</string>
				<string>public.folder</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
